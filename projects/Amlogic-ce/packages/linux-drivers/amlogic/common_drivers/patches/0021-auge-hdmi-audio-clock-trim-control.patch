 		fifo_id = aml_frddr_get_fifo_id(fr);
@@ -2499,6 +2504,7 @@
 #endif
 	/* share buffer free */
 	if (substream->stream == SNDRV_PCM_STREAM_PLAYBACK) {
+		aml_pll_trim_release(p_tdm);
 		if (p_tdm->samesource_sel != SHAREBUFFER_NONE)
 			tdm_sharebuffer_free(p_tdm, substream);
 	}
