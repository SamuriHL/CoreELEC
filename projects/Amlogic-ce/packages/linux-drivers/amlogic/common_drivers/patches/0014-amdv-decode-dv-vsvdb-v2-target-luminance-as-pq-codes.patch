+/* Dolby VSVDB v2 target luminance. Unlike v1 (max = 100 + 50 * CV nits,
+ * min = (CV / 127)^2 nits), the v2 5-bit fields index 12-bit PQ codes:
+ * max PQ = 2055 + 65 * idx, min PQ = 20 * idx (as edid-decode decodes them).
+ * Pre-converted through the ST 2084 EOTF since the kernel has no float.
+ */
+static const u32 dv_vsvdb_v2_max_nits[32] = { /* nits */
+	94, 110, 129, 150, 175, 204, 237, 276, 320, 372, 431,
+	499, 578, 670, 775, 897, 1037, 1200, 1387, 1605, 1856, 2147,
+	2485, 2876, 3330, 3857, 4470, 5183, 6014, 6982, 8113, 9434
+};
+
+static const u32 dv_vsvdb_v2_min_lum[32] = { /* 0.0001 nits */
+	0, 6, 22, 47, 83, 129, 188, 260, 347, 449, 569,
+	707, 865, 1044, 1247, 1475, 1729, 2012, 2325, 2671, 3052, 3470,
+	3927, 4427, 4972, 5564, 6206, 6902, 7655, 8468, 9345, 10289
+};
