From: SamuriHL <samurihl@msn.com>
Date: Wed, 30 Sep 2026 10:30:00 -0400
Subject: [PATCH] hdmitx21: expose the sink's SCDC lock as sink_lock

A player that holds its start across a mode set has no way to know when
the sink has locked onto the new signal, so it waits a fixed delay:
too long on one sink, too short on another. HDMI 2.0 sinks report their
TMDS lock in SCDC Status_Flags_0 (0x40: Clock_Detected, Ch0-2_Locked).

Add /sys/class/amhdmitx/amhdmitx0/sink_lock, read live on demand:
"0x4f clk=1 ch0=1 ch1=1 ch2=1 locked=1", or "na" (no SCDC in the sink's
HF-VSDB, no signal, or an FRL mode, where 0x40 means something else),
"busy" (a mode set holds hdmimode_mutex: it drives the DDC for
TMDS_Config without ddc_mutex) or "err" (the DDC reported an error; a
read that only times out shows 0x00, locked=0). The
cached chlocked_st is only refreshed by the CED worker, off by default,
and Update_0 is not written, so that worker's Status_Update is kept.

---
--- a/drivers/media/vout/hdmitx21/hdmi_tx_main.c
+++ b/drivers/media/vout/hdmitx21/hdmi_tx_main.c
@@ -2780,6 +2780,45 @@
 	return pos;
 }
 
+/*
+ * The sink's own TMDS lock, read live from SCDC Status_Flags_0 (0x40):
+ * Clock_Detected and Ch0-2_Locked. A player starts content once the link
+ * is locked after a mode set instead of after a fixed delay. The cached
+ * chlocked_st is only refreshed by the CED worker, which is off by
+ * default, and Update_0 is left alone for it.
+ * "na": no SCDC, no signal or an FRL mode; "busy": a mode set holds the
+ * DDC; "err": the read failed.
+ */
+static ssize_t sink_lock_show(struct device *dev,
+			      struct device_attribute *attr,
+			      char *buf)
+{
+	struct hdmitx_dev *hdev = dev_get_drvdata(dev);
+	u8 val = 0;
+	ssize_t pos;
+
+	/* the mode set drives the DDC for TMDS_Config without ddc_mutex */
+	if (!mutex_trylock(&hdev->tx_comm.hdmimode_mutex))
+		return snprintf(buf, PAGE_SIZE, "busy\n");
+	if (!hdev->tx_comm.hpd_state || !hdev->tx_comm.ready ||
+	    hdev->tx_comm.rxcap.scdc_present != 1 ||
+	    hdmitx_hw_cntl_misc(&hdev->tx_hw.base, MISC_GET_FRL_MODE, 0) > FRL_NONE) {
+		mutex_unlock(&hdev->tx_comm.hdmimode_mutex);
+		return snprintf(buf, PAGE_SIZE, "na\n");
+	}
+	if (hdmitx_ddcm_read(0, DDC_SCDC_ADDR, SCDC_STATUS_FLAGS_0, &val, 1,
+			     TPI_DDC_CMD_SEQUENTIAL_READ)) {
+		mutex_unlock(&hdev->tx_comm.hdmimode_mutex);
+		return snprintf(buf, PAGE_SIZE, "err\n");
+	}
+	mutex_unlock(&hdev->tx_comm.hdmimode_mutex);
+
+	pos = snprintf(buf, PAGE_SIZE, "0x%02x clk=%d ch0=%d ch1=%d ch2=%d locked=%d\n",
+		       val, val & 1, (val >> 1) & 1, (val >> 2) & 1, (val >> 3) & 1,
+		       (val & 0x0f) == 0x0f);
+	return pos;
+}
+
 static ssize_t cedst_count_show(struct device *dev,
 				struct device_attribute *attr,
 				char *buf)
@@ -3808,6 +3847,7 @@
 static DEVICE_ATTR_RW(rxsense_policy);
 static DEVICE_ATTR_RW(cedst_policy);
 static DEVICE_ATTR_RO(cedst_count);
+static DEVICE_ATTR_RO(sink_lock);
 static DEVICE_ATTR_RW(hdcp_mode);
 static DEVICE_ATTR_RO(hdcp_ver);
 static DEVICE_ATTR_RW(hdcp_type_policy);
@@ -4916,6 +4956,7 @@
 	ret = device_create_file(dev, &dev_attr_rxsense_state);
 	ret = device_create_file(dev, &dev_attr_cedst_policy);
 	ret = device_create_file(dev, &dev_attr_cedst_count);
+	ret = device_create_file(dev, &dev_attr_sink_lock);
 	ret = device_create_file(dev, &dev_attr_hdcp_mode);
 	ret = device_create_file(dev, &dev_attr_hdcp_ver);
 	ret = device_create_file(dev, &dev_attr_hdcp_type_policy);
@@ -5144,6 +5185,7 @@
 	device_remove_file(dev, &dev_attr_rxsense_state);
 	device_remove_file(dev, &dev_attr_cedst_policy);
 	device_remove_file(dev, &dev_attr_cedst_count);
+	device_remove_file(dev, &dev_attr_sink_lock);
 	device_remove_file(dev, &dev_attr_hdcp_type_policy);
 	device_remove_file(dev, &dev_attr_hdmi_hdr_status);
 	device_remove_file(dev, &dev_attr_hdcp_ver);
