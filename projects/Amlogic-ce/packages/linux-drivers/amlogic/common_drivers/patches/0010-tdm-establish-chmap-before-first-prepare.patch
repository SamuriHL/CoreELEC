+/* Attach the channel map control to this PCM unless it is attached already.
+ * Safe to call more than once; aml_soc_tdm_trigger() tears the control down
+ * again on stop.
+ */
+static int aml_dai_tdm_chmap_ctl_create(struct snd_pcm_substream *substream,
+					struct aml_tdm *p_tdm)
+{
+	struct snd_pcm_chmap *chmap;
+	struct snd_pcm_chmap *info;
+	struct snd_kcontrol *kctl;
+	int ret, i;
+
+	if (substream->stream != SNDRV_PCM_STREAM_PLAYBACK)
+		return 0;
+	if (aml_dai_tdm_chmap_kctrl_get(substream))
+		return 0;
+
+	ret = snd_pcm_add_chmap_ctls(substream->pcm, SNDRV_PCM_STREAM_PLAYBACK,
+				     NULL, 8, 0, &chmap);
+	if (ret < 0)
+		return ret;
+
+	kctl = chmap->kctl;
+	for (i = 0; i < kctl->count; i++)
+		kctl->vd[i].access |= SNDRV_CTL_ELEM_ACCESS_WRITE;
+
+	kctl->get = aml_dai_tdm_chmap_ctl_get;
+	kctl->put = aml_dai_tdm_chmap_ctl_put;
+	kctl->tlv.c = aml_dai_tdm_chmap_ctl_tlv;
+
+	info = snd_kcontrol_chip(kctl);
+	info->private_data = &p_tdm->chmap;
+
+	return 0;
+}
