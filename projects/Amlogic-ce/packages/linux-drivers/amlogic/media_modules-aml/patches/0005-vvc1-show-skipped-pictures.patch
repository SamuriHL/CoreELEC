 					__func__, buffer_index, hw->decoding_index,
 					hw->pics[hw->decoding_index].buffer_info,
@@ -1080,9 +1172,12 @@
 				vc1_print(0, VC1_DEBUG_DETAIL,"%s: index %d, buf_use %d, buffer_index %d\n",
 					__func__, hw->decoding_index, hw->buf_use[hw->decoding_index], buffer_index);
 			} else {
+				struct pic_info_t *show = NULL;
+
 				if ((picture_type == I_PICTURE) ||
 					(picture_type == P_PICTURE)) {
-					buffer_index = update_reference(hw, hw->decoding_index);
+					show = update_reference(hw,
+						&hw->pics[hw->decoding_index]);
 				} else {
 					/* drop b frame before reference pic ready */
 					if (hw->refs[0] == -1) {
@@ -1091,17 +1186,32 @@
 						hw->buf_use[hw->decoding_index]--;
 						vc1_print(0, VC1_DEBUG_DETAIL,"%s: decoding_index %d, buf_use %d\n",
 							__func__, hw->decoding_index, hw->buf_use[hw->decoding_index]);
+					} else if (buffer_index < hw->vf_buf_num_used) {
+						show = &hw->pics[buffer_index];
 					}
 				}
 
-				if (buffer_index < hw->vf_buf_num_used) {
-					vc1_print(0, VC1_DEBUG_DETAIL, "%s: show buffer_index %d\n",	__func__, buffer_index);
-					prepare_display_buf(hw, &hw->pics[buffer_index]);
+				if (show) {
+					vc1_print(0, VC1_DEBUG_DETAIL, "%s: show buffer_index %d\n",	__func__, show->index);
+					prepare_display_buf(hw, show);
 				} else {
 					vc1_print(0, VC1_DEBUG_DETAIL, "%s: drop buffer_index %d\n",	__func__, buffer_index);
 				}
 			}
 
+			/*
+			 * Before the next picture's anchors are set below. A skip
+			 * takes no decode buffer, so nothing else holds the firmware
+			 * back: wait for frame slots (two for the fields).
+			 */
+			for (; hw->skip_pending; hw->skip_pending--) {
+				while (kfifo_len(&newframe_q) < 2 &&
+					!is_reset && !is_irq_cancel)
+					msleep(wait_time);
+				if (hw->refs[1] != -1)
+					vvc1_skipped_picture(hw);
+			}
+
 			frame_dur = vvc1_amstream_dec_info.rate;
 			frame_width = vvc1_amstream_dec_info.width;
 			frame_height = vvc1_amstream_dec_info.height;
@@ -1189,7 +1299,9 @@
 
 			if (--hw->vfbuf_use[vf->index] == 0) {
 				WRITE_VREG(VC1_BUFFERIN, ~(1 << vf->index));
-				hw->buf_use[vf->index]--;
+				/* a skipped picture shows its anchor's buffer again */
+				if (hw->buf_use[vf->index] > 0)
+					hw->buf_use[vf->index]--;
 			}
 
