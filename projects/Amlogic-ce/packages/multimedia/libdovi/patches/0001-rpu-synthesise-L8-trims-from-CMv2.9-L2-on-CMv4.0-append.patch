+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::utils::nits_to_pq_12_bit;
+
+    #[test]
+    fn preset_target_index_nearest_in_pq() {
+        assert_eq!(
+            ExtMetadataBlockLevel8::preset_target_index_for_pq(nits_to_pq_12_bit(100u16)),
+            1
+        );
+        assert_eq!(
+            ExtMetadataBlockLevel8::preset_target_index_for_pq(nits_to_pq_12_bit(600u16)),
+            27
+        );
+        assert_eq!(
+            ExtMetadataBlockLevel8::preset_target_index_for_pq(nits_to_pq_12_bit(1000u16)),
+            48
+        );
+        // extremes clamp to the dimmest/brightest presets
+        assert_eq!(ExtMetadataBlockLevel8::preset_target_index_for_pq(0), 16);
+        assert_eq!(ExtMetadataBlockLevel8::preset_target_index_for_pq(4095), 37);
+    }
+
+    #[test]
+    fn l8_from_l2_copies_trims() {
+        let l2 = ExtMetadataBlockLevel2 {
+            target_max_pq: 2081,
+            trim_slope: 2000,
+            trim_offset: 4095,
+            trim_power: 2100,
+            trim_chroma_weight: 2047,
+            trim_saturation_gain: 2020,
+            ms_weight: -1,
+        };
+
+        let l8 = ExtMetadataBlockLevel8::from_cmv29_level2(&l2);
+        l8.validate().unwrap();
+
+        assert_eq!(l8.length, 10);
+        assert_eq!(l8.target_display_index, 1);
+        // engine-dependent slope/power: 1/16 of the deviation retained
+        assert_eq!(l8.trim_slope, 2045); // 2048 + (2000-2048)/16
+        assert_eq!(l8.trim_power, 2051); // 2048 + (2100-2048)/16
+        // offset/chroma/saturation copy verbatim
+        assert_eq!(l8.trim_offset, 4095);
+        assert_eq!(l8.trim_chroma_weight, 2047);
+        assert_eq!(l8.trim_saturation_gain, 2020);
+        // unused (negative) L2 ms_weight maps to neutral
+        assert_eq!(l8.ms_weight, 2048);
+
+        let l2_used_ms = ExtMetadataBlockLevel2 {
+            ms_weight: 1000,
+            ..l2
+        };
+        assert_eq!(
+            ExtMetadataBlockLevel8::from_cmv29_level2(&l2_used_ms).ms_weight,
+            1000
+        );
+    }
+
+    #[test]
+    fn default_safe_with_l8_no_l2_matches_default_safe() {
+        let dm_data = CmV40DmData::default_safe_with_l8_from_l2(&[]);
+        assert_eq!(dm_data.num_ext_blocks(), 4);
+        assert!(dm_data.blocks_ref().iter().all(|b| b.level() != 8));
+        dm_data.validate().unwrap();
+    }
+
+    #[test]
+    fn default_safe_with_l8_one_block_per_target() {
+        let l2_blocks: Vec<ExtMetadataBlockLevel2> = [100u16, 600, 1000]
+            .iter()
+            .map(|nits| ExtMetadataBlockLevel2 {
+                target_max_pq: nits_to_pq_12_bit(*nits),
+                ..Default::default()
+            })
+            .collect();
+
+        let dm_data = CmV40DmData::default_safe_with_l8_from_l2(&l2_blocks);
+        dm_data.validate().unwrap();
+        assert_eq!(dm_data.num_ext_blocks(), 7);
+
+        let l8_indexes: Vec<u8> = dm_data
+            .blocks_ref()
+            .iter()
+            .filter_map(|b| match b {
+                ExtMetadataBlock::Level8(l8) => Some(l8.target_display_index),
+                _ => None,
+            })
+            .collect();
+        assert_eq!(l8_indexes, vec![1, 27, 48]);
+    }
+
+    #[test]
+    fn default_safe_with_l8_nearest_wins_on_same_target() {
+        // both L2 targets land on the 100-nit preset; the closer one wins
+        let exact = ExtMetadataBlockLevel2 {
+            target_max_pq: nits_to_pq_12_bit(100u16),
+            trim_offset: 3000,
+            ..Default::default()
+        };
+        let near = ExtMetadataBlockLevel2 {
+            target_max_pq: nits_to_pq_12_bit(98u16),
+            trim_offset: 1000,
+            ..Default::default()
+        };
+
+        for order in [[&exact, &near], [&near, &exact]] {
+            let l2_blocks: Vec<ExtMetadataBlockLevel2> =
+                order.iter().map(|b| (*b).clone()).collect();
+            let dm_data = CmV40DmData::default_safe_with_l8_from_l2(&l2_blocks);
+
+            let l8_blocks: Vec<&ExtMetadataBlockLevel8> = dm_data
+                .blocks_ref()
+                .iter()
+                .filter_map(|b| match b {
+                    ExtMetadataBlock::Level8(l8) => Some(l8),
+                    _ => None,
+                })
+                .collect();
+            assert_eq!(l8_blocks.len(), 1);
+            assert_eq!(l8_blocks[0].target_display_index, 1);
+            assert_eq!(l8_blocks[0].trim_offset, 3000);
+        }
+    }
+}
