+    /// Like [`DoviRpu::add_cmv40_safe_default_metadata`], but additionally
+    /// synthesises L8 trim blocks from the RPU's CMv2.9 L2 trims so the
+    /// CM v4.0 DM keeps the authored trims (in CM v4.0 the DM computes L2
+    /// from L8 and ignores the source L2; with no L8 present the trims fall
+    /// back to neutral). See [`CmV40DmData::default_safe_with_l8_from_l2`].
+    ///
+    /// Returns:
+    /// - `Ok(0)` if CMv4.0 metadata was already present (nothing changed)
+    /// - `Ok(1)` if metadata was added with no L2 trims to carry over
+    /// - `Ok(2)` if metadata was added with L8 blocks synthesised from L2
+    pub fn add_cmv40_safe_metadata_with_l8_trims(&mut self) -> Result<u8> {
+        let Some(vdr_dm_data) = self.vdr_dm_data.as_mut() else {
+            return Ok(0);
+        };
+
+        if vdr_dm_data.cmv40_metadata.is_some() {
+            return Ok(0);
+        }
+
+        let l2_blocks: Vec<ExtMetadataBlockLevel2> = vdr_dm_data
+            .level_blocks_iter(2)
+            .filter_map(|b| match b {
+                ExtMetadataBlock::Level2(l2) => Some(l2.clone()),
+                _ => None,
+            })
+            .collect();
+
+        self.modified = true;
+        let _ = vdr_dm_data
+            .cmv40_metadata
+            .insert(DmData::V40(CmV40DmData::default_safe_with_l8_from_l2(
+                &l2_blocks,
+            )));
+
+        Ok(if l2_blocks.is_empty() { 1 } else { 2 })
+    }
