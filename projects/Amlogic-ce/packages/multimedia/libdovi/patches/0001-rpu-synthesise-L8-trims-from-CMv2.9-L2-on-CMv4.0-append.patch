@@ -6,7 +6,21 @@ use bitvec_helpers::{
 #[cfg(feature = "serde")]
 use serde::{Deserialize, Serialize, Serializer, ser::SerializeStruct};
 
-use super::{ExtMetadataBlock, ExtMetadataBlockInfo, MAX_12_BIT_VALUE};
+use super::{ExtMetadataBlock, ExtMetadataBlockInfo, ExtMetadataBlockLevel2, MAX_12_BIT_VALUE};
+use crate::utils::nits_to_pq_12_bit;
+
+/// Preset target displays with a known peak brightness, usable in L8
+/// without an authored L10 block: subset of
+/// [`super::level10::PRESET_TARGET_DISPLAYS`], one index per distinct
+/// brightness (see [`ExtMetadataBlockLevel8::trim_target_nits`]).
+const PRESET_TRIM_TARGETS: &[(u8, u16)] = &[
+    (1, 100),
+    (16, 48),
+    (42, 108),
+    (27, 600),
+    (48, 1000),
+    (37, 2000),
+];
 
 /// Creative intent trim passes per target display peak brightness
 /// For CM v4.0, L8 metadata only is present and used to compute L2
@@ -160,6 +174,63 @@ impl ExtMetadataBlockLevel8 {
             _ => 100,
         }
     }
+
+    /// Returns the preset target display index whose peak brightness is
+    /// closest (in 12-bit PQ space) to the given L2 `target_max_pq`.
+    pub fn preset_target_index_for_pq(target_max_pq: u16) -> u8 {
+        PRESET_TRIM_TARGETS
+            .iter()
+            .min_by_key(|(_, nits)| {
+                (nits_to_pq_12_bit(*nits) as i32 - target_max_pq as i32).abs()
+            })
+            .map(|(index, _)| *index)
+            .unwrap()
+    }
+
+    /// Synthesises an L8 trim block from a CMv2.9 L2 trim block, so that a
+    /// CM v4.0 DM (which computes L2 from L8 and ignores the source L2)
+    /// keeps the authored trims.
+    ///
+    /// The six core trims share the same 12-bit encoding (2048 = neutral).
+    /// `trim_offset`, `trim_chroma_weight`, `trim_saturation_gain` and
+    /// `ms_weight` copy over unchanged - on dual-authored (L2+L8, same
+    /// target) studio content Dolby's own tools carry these verbatim. A
+    /// negative (unused) L2 `ms_weight` maps to neutral.
+    ///
+    /// `trim_slope` and `trim_power` are ENGINE-DEPENDENT: they mostly
+    /// compensate the CM v2.9 tone curve, and the v4.0 curve does not need
+    /// that compensation - on the same dual-authored content the studio's
+    /// v4.0 values sit near neutral (studio retained ~3% of the slope and
+    /// ~9% of the power deviation). Carrying them verbatim over-corrects
+    /// through the v4.0 engine, so only 1/16 of their deviation from
+    /// neutral is retained (direction preserved, magnitude collapsed;
+    /// within ~0.5% of the studio's actual L8 on the measured sample).
+    ///
+    /// The block is created at length 10, omitting the L8-only fields
+    /// (`target_mid_contrast`, `clip_trim`, vectors) that have no L2
+    /// source. The target display becomes the nearest preset index, so no
+    /// L10 block is required.
+    pub fn from_cmv29_level2(l2: &ExtMetadataBlockLevel2) -> Self {
+        // retain 1/16 of the deviation from neutral (see doc comment)
+        const NEUTRAL: i32 = 2048;
+        let attenuate = |v: u16| (NEUTRAL + (v as i32 - NEUTRAL) / 16) as u16;
+
+        Self {
+            length: 10,
+            target_display_index: Self::preset_target_index_for_pq(l2.target_max_pq),
+            trim_slope: attenuate(l2.trim_slope),
+            trim_offset: l2.trim_offset,
+            trim_power: attenuate(l2.trim_power),
+            trim_chroma_weight: l2.trim_chroma_weight,
+            trim_saturation_gain: l2.trim_saturation_gain,
+            ms_weight: if l2.ms_weight < 0 {
+                2048
+            } else {
+                l2.ms_weight as u16
+            },
+            ..Default::default()
+        }
+    }
 }
 
 impl ExtMetadataBlockInfo for ExtMetadataBlockLevel8 {
diff --git a/dolby_vision/src/rpu/extension_metadata/cmv40.rs b/dolby_vision/src/rpu/extension_metadata/cmv40.rs
index 0c68252..1a8fd92 100644
--- a/dolby_vision/src/rpu/extension_metadata/cmv40.rs
+++ b/dolby_vision/src/rpu/extension_metadata/cmv40.rs
@@ -193,6 +193,46 @@ impl CmV40DmData {
         }
     }
 
+    /// Creates CMv4.0 DM data with the default static blocks (as
+    /// [`CmV40DmData::default_safe`]) plus L8 trim blocks synthesised from
+    /// the given CMv2.9 L2 trim blocks, so the v4.0 DM keeps the authored
+    /// trims (in CM v4.0 the DM computes L2 from L8; with no L8 present the
+    /// trims fall back to neutral).
+    ///
+    /// Each L2 target maps to the nearest preset target display; when two L2
+    /// blocks land on the same preset, the closer one (in PQ space) wins. At
+    /// most 5 L8 blocks are created, as the spec allows.
+    pub fn default_safe_with_l8_from_l2(l2_blocks: &[ExtMetadataBlockLevel2]) -> Self {
+        use crate::utils::nits_to_pq_12_bit;
+
+        // (target_display_index, PQ distance, block), nearest target wins
+        let mut chosen: Vec<(u8, u32, ExtMetadataBlockLevel8)> = Vec::new();
+
+        for l2 in l2_blocks {
+            let l8 = ExtMetadataBlockLevel8::from_cmv29_level2(l2);
+            let dist = (nits_to_pq_12_bit(l8.trim_target_nits()) as i32
+                - l2.target_max_pq as i32)
+                .unsigned_abs();
+
+            match chosen
+                .iter_mut()
+                .find(|(index, ..)| *index == l8.target_display_index)
+            {
+                Some(entry) if dist < entry.1 => *entry = (l8.target_display_index, dist, l8),
+                Some(_) => {}
+                None => chosen.push((l8.target_display_index, dist, l8)),
+            }
+        }
+
+        let mut dm_data = Self::default_safe();
+
+        for (_, _, l8) in chosen.iter().take(5) {
+            dm_data.replace_level8_block(l8);
+        }
+
+        dm_data
+    }
+
     pub fn new_with_custom_l254(level254: &ExtMetadataBlockLevel254) -> Self {
         Self {
             num_ext_blocks: 1,
@@ -200,3 +240,131 @@ impl CmV40DmData {
         }
     }
 }
