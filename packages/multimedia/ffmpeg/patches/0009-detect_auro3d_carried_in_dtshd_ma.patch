+/* Auro-3D rides in the low bits of an ordinary DTS-HD MA carrier. The scan in
+ * dca_xll.c can only see it in reconstructed samples and needs more of them
+ * than a single frame carries - DCA_AURO_SCAN_SAMPLES, sixteen frames at the
+ * usual 512 - but probing stops at the first decoded frame. Passthrough
+ * playback and the library scanner never decode a frame of their own, so
+ * without this they would never be told. Only DTS-HD MA pays for it: anything
+ * that is not DTS, or that the first frame already named DTS:X, drops out. */
+#define DCA_AURO_PROBE_FRAMES 16
+
+static int dca_auro_probe_pending(const AVStream *st)
+{
+    const FFStream *const sti = cffstream(st);
+    const AVCodecContext *const avctx = sti->avctx;
+
+    return avctx->codec_id == AV_CODEC_ID_DTS &&
+           sti->info->found_decoder >= 0 &&
+           sti->nb_decoded_frames < DCA_AURO_PROBE_FRAMES &&
+           (!sti->nb_decoded_frames || avctx->profile == AV_PROFILE_DTS_HD_MA);
+}
