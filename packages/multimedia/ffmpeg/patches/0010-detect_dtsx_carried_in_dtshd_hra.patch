+++ b/libavcodec/dcadec.c
@@ -211,6 +211,17 @@ static int dcadec_decode_frame(AVCodecContext *avctx, AVFrame *frame,
             } else {
                 s->packet |= DCA_PACKET_EXSS;
                 asset = &s->exss.assets[0];
+                if (!(asset->extension_mask & DCA_EXSS_XLL)) {
