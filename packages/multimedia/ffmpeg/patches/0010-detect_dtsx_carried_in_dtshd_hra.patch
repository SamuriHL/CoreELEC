 TESTPROGS-$(CONFIG_CELP_MATH)             += celp_math
 TESTPROGS-$(CONFIG_GOLOMB)                += golomb
 TESTPROGS-$(CONFIG_IDCTDSP)               += dct
diff --git a/libavcodec/dca_core.c b/libavcodec/dca_core.c
index cb1f7b7bbfaa81dcd7c1d1ac19519d028f03265a..34c903b1b90efda4e04180003795f4a0eb91e2aa 100644
--- a/libavcodec/dca_core.c
+++ b/libavcodec/dca_core.c
@@ -2370,8 +2370,14 @@ int ff_dca_core_filter_frame(DCACoreDecoder *s, AVFrame *frame)
         return ret;
 
     // Set profile, bit rate, etc
-    if (s->ext_audio_mask & DCA_EXSS_MASK)
-        avctx->profile = AV_PROFILE_DTS_HD_HRA;
+    if (s->ext_audio_mask & DCA_EXSS_MASK) {
+        avctx->profile = dca->hra_x_syncword ? AV_PROFILE_DTS_HD_HRA_X
+                                             : AV_PROFILE_DTS_HD_HRA;
+        if (dca->hra_x_syncword >= DCA_SYNCWORD_XLL_X_IMAX &&
+            dca->hra_x_syncword <= DCA_SYNCWORD_XLL_X_5)
+            avctx->level = (dca->hra_x_syncword & 0xf) |
+                           dca->hra_x_height_flags;
+    }
     else if (s->ext_audio_mask & (DCA_CSS_XXCH | DCA_CSS_XCH))
         avctx->profile = AV_PROFILE_DTS_ES;
     else if (s->ext_audio_mask & DCA_CSS_X96)
diff --git a/libavcodec/dca_exss.c b/libavcodec/dca_exss.c
index e873088f82dd7fdfd5b1cfeadec4878362caf691..8a38c422b6a731255b7e0e4767184fe676c1df81 100644
--- a/libavcodec/dca_exss.c
+++ b/libavcodec/dca_exss.c
@@ -18,7 +18,55 @@
  * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
  */
 
+#include <limits.h>
+
+#include "libavutil/intreadwrite.h"
+
 #include "dcadec.h"
+#include "dca_syncwords.h"
+
+uint32_t ff_dca_exss_hra_x_syncword(const DCAExssParser *s,
+                                    const uint8_t *data, int size,
+                                    int *height_flags)
+{
+    const DCAExssAsset *asset;
+    int end, payload_end, start;
+
+    if (height_flags)
+        *height_flags = 0;
+    if (!s || !data || size < 4 || s->nassets != 1)
+        return 0;
+
+    asset = &s->assets[0];
+    if (asset->extension_mask & DCA_EXSS_XLL ||
+        !(asset->extension_mask & (DCA_EXSS_XBR | DCA_EXSS_XXCH | DCA_EXSS_X96)) ||
+        asset->asset_offset < 0 || asset->asset_size < 0 ||
+        asset->asset_offset > INT_MAX - asset->asset_size)
+        return 0;
+
+    start = asset->asset_offset + asset->asset_size;
+    end = payload_end = FFMIN(size, s->exss_size);
+    if (start > end)
+        return 0;
+    if (end - start > 32)
+        end = start + 32;
+
+    for (; start <= end - 4; start++) {
+        uint32_t syncword = AV_RB32(data + start);
+
+        if (syncword == DCA_SYNCWORD_XLL_X_1)
+            return syncword;
+        if (syncword >= DCA_SYNCWORD_XLL_X_IMAX &&
+            syncword <= DCA_SYNCWORD_XLL_X_5) {
+            if (height_flags)
+                *height_flags = ff_dca_x_height_flags(data + start,
+                                                      payload_end - start);
+            return syncword;
+        }
+    }
+
+    return 0;
+}
 
 static void parse_xll_parameters(DCAExssParser *s, DCAExssAsset *asset)
 {
diff --git a/libavcodec/dca_exss.h b/libavcodec/dca_exss.h
index 9e91b00bfdf1f2d8dbc2cd4980c99ff709683280..3ca481e8e85e65c44ef4815f79649667ebd6a798 100644
--- a/libavcodec/dca_exss.h
+++ b/libavcodec/dca_exss.h
@@ -88,5 +88,8 @@ typedef struct DCAExssParser {
 } DCAExssParser;
 
 int ff_dca_exss_parse(DCAExssParser *s, const uint8_t *data, int size);
+uint32_t ff_dca_exss_hra_x_syncword(const DCAExssParser *s,
+                                    const uint8_t *data, int size,
+                                    int *height_flags);
 
 #endif
diff --git a/libavcodec/dca_parser.c b/libavcodec/dca_parser.c
index aaf4f422219deebc7209b4270078e7293a0dc444..dad581470a85c16907aea3f4c7e7896b1c252457 100644
--- a/libavcodec/dca_parser.c
+++ b/libavcodec/dca_parser.c
@@ -193,12 +193,13 @@ static av_cold int dca_parse_init(AVCodecParserContext *s)
 
 static int dca_parse_params(DCAParseContext *pc1, const uint8_t *buf,
                             int buf_size, int *duration, int *sample_rate,
-                            int *profile)
+                            int *profile, int *level)
 {
     DCAExssAsset *asset = &pc1->exss.assets[0];
     GetBitContext gb;
     DCACoreFrameHeader h;
     uint8_t hdr[DCA_CORE_FRAME_HEADER_SIZE + AV_INPUT_BUFFER_PADDING_SIZE] = { 0 };
+    int probe_hra_x = *profile == AV_PROFILE_DTS_HD_HRA;
     int ret, frame_size;
 
     if (buf_size < DCA_CORE_FRAME_HEADER_SIZE)
@@ -269,19 +270,21 @@ static int dca_parse_params(DCAParseContext *pc1, const uint8_t *buf,
 
     *duration = h.npcmblocks * DCA_PCMBLOCK_SAMPLES;
     *sample_rate = ff_dca_sample_rates[h.sr_code];
-    if (*profile != AV_PROFILE_UNKNOWN)
+    if (*profile != AV_PROFILE_UNKNOWN && !probe_hra_x)
         return 0;
 
-    *profile = AV_PROFILE_DTS;
-    if (h.ext_audio_present) {
-        switch (h.ext_audio_type) {
-        case DCA_EXT_AUDIO_XCH:
-        case DCA_EXT_AUDIO_XXCH:
-            *profile = AV_PROFILE_DTS_ES;
-            break;
-        case DCA_EXT_AUDIO_X96:
-            *profile = AV_PROFILE_DTS_96_24;
-            break;
+    if (!probe_hra_x) {
+        *profile = AV_PROFILE_DTS;
+        if (h.ext_audio_present) {
+            switch (h.ext_audio_type) {
+            case DCA_EXT_AUDIO_XCH:
+            case DCA_EXT_AUDIO_XXCH:
+                *profile = AV_PROFILE_DTS_ES;
+                break;
+            case DCA_EXT_AUDIO_X96:
+                *profile = AV_PROFILE_DTS_96_24;
+                break;
+            }
         }
     }
 
@@ -298,8 +301,20 @@ static int dca_parse_params(DCAParseContext *pc1, const uint8_t *buf,
 
     if (asset->extension_mask & DCA_EXSS_XLL)
         *profile = AV_PROFILE_DTS_HD_MA;
-    else if (asset->extension_mask & (DCA_EXSS_XBR | DCA_EXSS_XXCH | DCA_EXSS_X96))
-        *profile = AV_PROFILE_DTS_HD_HRA;
+    else if (asset->extension_mask & (DCA_EXSS_XBR | DCA_EXSS_XXCH | DCA_EXSS_X96)) {
+        int height_flags;
+        uint32_t syncword = ff_dca_exss_hra_x_syncword(&pc1->exss, buf, buf_size,
+                                                       &height_flags);
+
+        if (syncword) {
+            *profile = AV_PROFILE_DTS_HD_HRA_X;
+            if (syncword >= DCA_SYNCWORD_XLL_X_IMAX &&
+                syncword <= DCA_SYNCWORD_XLL_X_5)
+                *level = (syncword & 0xf) | height_flags;
+        } else {
+            *profile = AV_PROFILE_DTS_HD_HRA;
+        }
+    }
 
     return 0;
 }
@@ -332,7 +347,8 @@ static int dca_parse(AVCodecParserContext *s, AVCodecContext *avctx,
     }
 
     /* read the duration and sample rate from the frame header */
-    if (!dca_parse_params(pc1, buf, buf_size, &duration, &sample_rate, &avctx->profile)) {
+    if (!dca_parse_params(pc1, buf, buf_size, &duration, &sample_rate,
+                          &avctx->profile, &avctx->level)) {
         if (!avctx->sample_rate)
             avctx->sample_rate = sample_rate;
         s->duration = av_rescale(duration, avctx->sample_rate, sample_rate);
