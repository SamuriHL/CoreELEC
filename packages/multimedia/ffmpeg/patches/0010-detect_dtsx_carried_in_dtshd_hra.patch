     int     request_channel_layout; ///< Converted from avctx.request_channel_layout
     int     core_only;              ///< Core only decoding flag
diff --git a/libavcodec/defs.h b/libavcodec/defs.h
index 1d2e799730de120fe8a9906e6f54d22709a759da..8ea04f257eb2afc8a19070d190cff6ab900e9aa6 100644
--- a/libavcodec/defs.h
+++ b/libavcodec/defs.h
@@ -93,6 +93,7 @@
 #define AV_PROFILE_DTS_HD_MA_X        61
 #define AV_PROFILE_DTS_HD_MA_X_IMAX   62
 #define AV_PROFILE_DTS_HD_MA_AURO3D   63
+#define AV_PROFILE_DTS_HD_HRA_X       64
 
 #define AV_PROFILE_EAC3_DDP_ATMOS         30
 
diff --git a/libavcodec/profiles.c b/libavcodec/profiles.c
index d846ba9a0aefa32de83ae15ffcb02ec4aa587164..8f8ef5f7fd5846e677e1fcfa4d21895d6bca47cc 100644
