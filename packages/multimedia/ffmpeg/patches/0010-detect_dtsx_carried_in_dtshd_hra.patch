+++ b/libavcodec/profiles.c
@@ -46,6 +46,7 @@ const AVProfile ff_dca_profiles[] = {
     { AV_PROFILE_DTS_HD_MA_X,        "DTS-HD MA + DTS:X"      },
     { AV_PROFILE_DTS_HD_MA_X_IMAX,   "DTS-HD MA + DTS:X IMAX" },
     { AV_PROFILE_DTS_HD_MA_AURO3D,   "DTS-HD MA + Auro-3D"    },
+    { AV_PROFILE_DTS_HD_HRA_X,        "DTS-HD HRA + DTS:X"     },
     { AV_PROFILE_DTS_EXPRESS,        "DTS Express"            },
     { AV_PROFILE_UNKNOWN },
 };
diff --git a/libavcodec/tests/dca_exss.c b/libavcodec/tests/dca_exss.c
new file mode 100644
index 0000000000000000000000000000000000000000..07317e80fabcb99bf8cb9e3f2241ec298bd6d04e
--- /dev/null
+++ b/libavcodec/tests/dca_exss.c
@@ -0,0 +1,169 @@
+/*
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+
+#include <limits.h>
+#include <stdio.h>
+#include <stdint.h>
+#include <string.h>
+
+#include "libavutil/intreadwrite.h"
+
+#include "libavcodec/dca.h"
+#include "libavcodec/dca_exss.h"
+#include "libavcodec/dca_syncwords.h"
+
+#define CHECK(condition) do {                                            \
+    if (!(condition)) {                                                  \
+        fprintf(stderr, "check failed at line %d: %s\n",                \
+                __LINE__, #condition);                                   \
+        return 1;                                                        \
+    }                                                                    \
+} while (0)
+
+/* Bit by bit, and so independent of the table the code under test uses:
+ * CRC16-CCITT, 0xffff in, nothing out. */
+static unsigned crc16(const uint8_t *data, int size)
+{
+    unsigned crc = 0xffff;
+
+    for (int i = 0; i < size; i++) {
+        crc ^= data[i] << 8;
+        for (int bit = 0; bit < 8; bit++)
+            crc = crc & 0x8000 ? (crc << 1 ^ 0x1021) & 0xffff : crc << 1 & 0xffff;
+    }
+    return crc;
+}
+
+/* A protected prefix ending at pos, then the set byte and the tail. */
+static void plant_sets(uint8_t *payload, int pos, int sets)
+{
+    static const uint8_t tail[] = { 0x34, 0x38, 0x8c, 0x4f, 0x00 };
+
+    AV_WB16(payload + pos - 2, crc16(payload, pos - 2));
+    payload[pos] = sets;
+    memcpy(payload + pos + 1, tail, sizeof(tail));
+}
+
+static int x_payload(uint8_t *payload, int size, int pos, int sets)
+{
+    memset(payload, 0, size);
+    AV_WB32(payload, DCA_SYNCWORD_XLL_X_3);
+    for (int i = 4; i < pos - 2; i++)
+        payload[i] = i * 37;
+    plant_sets(payload, pos, sets);
+    return ff_dca_x_height_flags(payload, size);
+}
+
+static uint32_t detect(uint32_t syncword)
+{
+    DCAExssParser parser = { 0 };
+    uint8_t data[64] = { 0 };
+
+    parser.nassets = 1;
+    parser.exss_size = sizeof(data);
+    parser.assets[0].extension_mask = DCA_EXSS_XXCH;
+    parser.assets[0].asset_offset = 8;
+    parser.assets[0].asset_size = 12;
+    AV_WB32(data + 26, syncword);
+    return ff_dca_exss_hra_x_syncword(&parser, data, sizeof(data), NULL);
+}
+
+int main(void)
+{
+    static const uint32_t syncwords[] = {
+        DCA_SYNCWORD_XLL_X_1,
+        DCA_SYNCWORD_XLL_X_IMAX,
+        DCA_SYNCWORD_XLL_X_2,
+        DCA_SYNCWORD_XLL_X_3,
+        DCA_SYNCWORD_XLL_X_4,
+        DCA_SYNCWORD_XLL_X_5,
+    };
+    DCAExssParser parser = { 0 };
+    uint8_t data[64] = { 0 };
+    uint8_t payload[128];
+    int height_flags;
+
+    for (unsigned i = 0; i < FF_ARRAY_ELEMS(syncwords); i++)
+        CHECK(detect(syncwords[i]) == syncwords[i]);
+    CHECK(detect(0xf14000d5) == 0);
+
+    parser.nassets = 1;
+    parser.exss_size = sizeof(data);
+    parser.assets[0].extension_mask = DCA_EXSS_XBR;
+    parser.assets[0].asset_offset = 8;
+    parser.assets[0].asset_size = 12;
+
+    AV_WB32(data + 48, DCA_SYNCWORD_XLL_X_1);
+    CHECK(ff_dca_exss_hra_x_syncword(&parser, data, sizeof(data), NULL) ==
+          DCA_SYNCWORD_XLL_X_1);
+    memset(data, 0, sizeof(data));
+    AV_WB32(data + 49, DCA_SYNCWORD_XLL_X_1);
+    CHECK(ff_dca_exss_hra_x_syncword(&parser, data, sizeof(data), NULL) == 0);
+
+    AV_WB32(data + 26, DCA_SYNCWORD_XLL_X_1);
+    parser.assets[0].extension_mask = DCA_EXSS_XLL;
+    CHECK(ff_dca_exss_hra_x_syncword(&parser, data, sizeof(data), NULL) == 0);
+    parser.assets[0].extension_mask = DCA_EXSS_CORE;
+    CHECK(ff_dca_exss_hra_x_syncword(&parser, data, sizeof(data), NULL) == 0);
+    parser.assets[0].extension_mask = DCA_EXSS_XXCH;
+    parser.nassets = 2;
+    CHECK(ff_dca_exss_hra_x_syncword(&parser, data, sizeof(data), NULL) == 0);
+
+    parser.nassets = 1;
+    parser.exss_size = 25;
+    CHECK(ff_dca_exss_hra_x_syncword(&parser, data, sizeof(data), NULL) == 0);
+    parser.exss_size = sizeof(data);
+    parser.assets[0].asset_offset = INT_MAX;
+    parser.assets[0].asset_size = 1;
+    CHECK(ff_dca_exss_hra_x_syncword(&parser, data, sizeof(data), NULL) == 0);
+
+    /* The channel-set byte: heights, none, and every way of saying nothing. */
+    CHECK(x_payload(payload, sizeof(payload), 20, 0x03) ==
+          (DCA_X_LEVEL_SETS_READ | DCA_X_LEVEL_HEIGHTS));
+    CHECK(x_payload(payload, sizeof(payload), 20, 0x01) == DCA_X_LEVEL_SETS_READ);
+    CHECK(x_payload(payload, sizeof(payload), 16, 0x03) ==
+          (DCA_X_LEVEL_SETS_READ | DCA_X_LEVEL_HEIGHTS));
+    CHECK(x_payload(payload, sizeof(payload), 95, 0x01) == DCA_X_LEVEL_SETS_READ);
+    CHECK(x_payload(payload, sizeof(payload), 96, 0x03) == 0);
+    CHECK(x_payload(payload, sizeof(payload), 20, 0x02) == 0);
+    CHECK(x_payload(payload, sizeof(payload), 20, 0x07) == 0);
+    CHECK(x_payload(payload, 25, 20, 0x03) == 0);
+    x_payload(payload, sizeof(payload), 20, 0x03);
+    payload[10] ^= 1;
+    CHECK(ff_dca_x_height_flags(payload, sizeof(payload)) == 0);
+    x_payload(payload, sizeof(payload), 20, 0x03);
+    payload[23] ^= 1;
+    CHECK(ff_dca_x_height_flags(payload, sizeof(payload)) == 0);
+    x_payload(payload, sizeof(payload), 20, 0x03);
+    plant_sets(payload, 40, 0x01);
+    CHECK(ff_dca_x_height_flags(payload, sizeof(payload)) == 0);
+
+    /* Found through the HRA search, from the syncword to the end of the EXSS. */
+    memset(data, 0, sizeof(data));
+    parser.assets[0].asset_offset = 8;
+    parser.assets[0].asset_size = 12;
+    parser.exss_size = sizeof(data);
+    x_payload(payload, sizeof(payload), 20, 0x01);
+    memcpy(data + 22, payload, 26);
+    CHECK(ff_dca_exss_hra_x_syncword(&parser, data, sizeof(data), &height_flags) ==
+          DCA_SYNCWORD_XLL_X_3);
+    CHECK(height_flags == DCA_X_LEVEL_SETS_READ);
+    parser.exss_size = 22 + 25;
+    CHECK(ff_dca_exss_hra_x_syncword(&parser, data, sizeof(data), &height_flags) ==
+          DCA_SYNCWORD_XLL_X_3);
+    CHECK(height_flags == 0);
+    parser.exss_size = sizeof(data);
+    memset(data, 0, sizeof(data));
+    AV_WB32(data + 22, DCA_SYNCWORD_XLL_X_1);
+    CHECK(ff_dca_exss_hra_x_syncword(&parser, data, sizeof(data), &height_flags) ==
+          DCA_SYNCWORD_XLL_X_1);
+    CHECK(height_flags == 0);
+
+    return 0;
+}
diff --git a/libavformat/demux.c b/libavformat/demux.c
index 7c247995308106c32d8397ef719b0cbecf6041d7..3ebc11dfea41cb33d45db7197e7595d6c24a7445 100644
--- a/libavformat/demux.c
+++ b/libavformat/demux.c
@@ -2137,21 +2137,24 @@ static int has_codec_parameters(const AVStream *st, const char **errmsg_ptr)
 /* Auro-3D rides in the low bits of an ordinary DTS-HD MA carrier. The scan in
  * dca_xll.c can only see it in reconstructed samples and needs more of them
  * than a single frame carries - DCA_AURO_SCAN_SAMPLES, sixteen frames at the
- * usual 512 - but probing stops at the first decoded frame. Passthrough
- * playback and the library scanner never decode a frame of their own, so
- * without this they would never be told. Only DTS-HD MA pays for it: anything
- * that is not DTS, or that the first frame already named DTS:X, drops out. */
-#define DCA_AURO_PROBE_FRAMES 16
-
-static int dca_auro_probe_pending(const AVStream *st)
+ * usual 512 - but probing stops at the first decoded frame. DTS:X metadata can
+ * likewise follow a lossy HRA asset and may not be present in the first packet.
+ * Passthrough playback and the library scanner never decode frames themselves,
+ * so keep the bounded opening probe active for undecided MA and HRA streams.
+ * A distinct spatial profile ends the extra work immediately. */
+#define DCA_SPATIAL_PROBE_FRAMES 16
+
+static int dca_spatial_probe_pending(const AVStream *st)
 {
     const FFStream *const sti = cffstream(st);
     const AVCodecContext *const avctx = sti->avctx;
 
     return avctx->codec_id == AV_CODEC_ID_DTS &&
            sti->info->found_decoder >= 0 &&
-           sti->nb_decoded_frames < DCA_AURO_PROBE_FRAMES &&
-           (!sti->nb_decoded_frames || avctx->profile == AV_PROFILE_DTS_HD_MA);
+           sti->nb_decoded_frames < DCA_SPATIAL_PROBE_FRAMES &&
+           (!sti->nb_decoded_frames ||
+            avctx->profile == AV_PROFILE_DTS_HD_MA ||
+            avctx->profile == AV_PROFILE_DTS_HD_HRA);
 }
 
 /* returns 1 or 0 if or if not decoded data was returned, or a negative error */
@@ -2218,7 +2221,7 @@ static int try_decode_frame(AVFormatContext *s, AVStream *st,
