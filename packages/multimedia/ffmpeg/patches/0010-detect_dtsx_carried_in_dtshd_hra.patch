From 25657dc523fb9c9128c68501e95a11af40a6ef0a Mon Sep 17 00:00:00 2001
From: v-lix <280294695+v-lix@users.noreply.github.com>
Date: Tue, 22 Sep 2026 16:53:20 -0500
Subject: [PATCH] avcodec/dca: detect DTS:X carried in DTS-HD HRA

---
 libavcodec/Makefile         |   1 +
 libavcodec/dca_core.c       |  10 ++-
 libavcodec/dca_exss.c       |  48 ++++++++++
 libavcodec/dca_exss.h       |   3 +
 libavcodec/dca_parser.c     |  46 ++++++----
 libavcodec/dcadec.c         |  11 +++
 libavcodec/dcadec.h         |   2 +
 libavcodec/defs.h           |   1 +
 libavcodec/profiles.c       |   1 +
 libavcodec/tests/dca_exss.c | 169 ++++++++++++++++++++++++++++++++++++
 libavformat/demux.c         |  25 +++---
 tests/fate/libavcodec.mak   |   5 ++
 12 files changed, 294 insertions(+), 28 deletions(-)
 create mode 100644 libavcodec/tests/dca_exss.c

