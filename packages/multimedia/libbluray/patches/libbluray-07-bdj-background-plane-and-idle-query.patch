@@ -39,9 +39,101 @@ public class HStillImageBackgroundConfiguration extends
     public void displayImage(HBackgroundImage image, HScreenRectangle r)
             throws IOException, HPermissionDeniedException,
             HConfigurationException {
-        org.videolan.Logger.unimplemented("HStillImageBackgroundConfiguration", "displayImage()");
-        this.image = image;
-        this.rect = r;
+        if (image == null || image.getImage() == null)
+            throw new IOException("no background image");
+        if (r == null)
+            r = new HScreenRectangle(0.0f, 0.0f, 1.0f, 1.0f);
+
+        synchronized (this) {
+            this.image = image;
+            this.rect = r;
+        }
+
+        /* Decode into our own pixel copy: HBackgroundImage.flush() releases the
+         * image's buffers, and a later setColor() must still redraw it.
+         * Image fetcher threads must not block on a decode that needs a fetcher
+         * thread (discs call displayImage() from imageLoaded()), so there the
+         * decode moves to a worker. */
+        boolean onFetcher = Thread.currentThread().getName().startsWith("Image Fetcher");
+        if (!onFetcher) {
+            int result = decode(image, r, DECODE_WAIT_MS);
+            if (result == DECODE_FAILED)
+                throw new IOException("background image decode failed");
+            if (result == DECODE_DONE)
+                return;
+        }
+        decodeAsync(image, r);
+    }
+
+    private static final int DECODE_DONE    = 0;
+    private static final int DECODE_FAILED  = 1;
+    private static final int DECODE_TIMEOUT = 2;
+    private static final long DECODE_WAIT_MS       = 2000;
+    private static final long DECODE_ASYNC_WAIT_MS = 10000;
+
+    private int decode(HBackgroundImage image, HScreenRectangle r, long waitMs) {
+        java.awt.image.PixelGrabber pg =
+            new java.awt.image.PixelGrabber(image.getImage(), 0, 0, -1, -1, true);
+        boolean done;
+        try {
+            done = pg.grabPixels(waitMs);
+        } catch (InterruptedException e) {
+            return DECODE_TIMEOUT;
+        }
+        if ((pg.getStatus() & (java.awt.image.ImageObserver.ERROR | java.awt.image.ImageObserver.ABORT)) != 0)
+            return DECODE_FAILED;
+        if (!done)
+            return DECODE_TIMEOUT;
+
+        Object px = pg.getPixels();
+        if (!(px instanceof int[]) || pg.getWidth() <= 0 || pg.getHeight() <= 0)
+            return DECODE_FAILED;
+
+        synchronized (this) {
+            /* a newer displayImage() replaced this one while decoding */
+            if (this.image != image || this.rect != r)
+                return DECODE_DONE;
+            decodedPixels = (int[])px;
+            decodedWidth  = pg.getWidth();
+            decodedHeight = pg.getHeight();
+        }
+        BackgroundPlane.contentChanged(this);
+        return DECODE_DONE;
+    }
+
+    private void decodeAsync(final HBackgroundImage image, final HScreenRectangle r) {
+        Thread t = new Thread("HBackgroundImage decode") {
+            public void run() {
+                if (decode(image, r, DECODE_ASYNC_WAIT_MS) != DECODE_DONE)
+                    org.videolan.Logger.getLogger("HStillImageBackgroundConfiguration")
+                        .error("background image decode failed or timed out");
+            }
+        };
+        t.setDaemon(true);
+        t.start();
+    }
+
+    void resetBackground() {
+        super.resetBackground();
+        synchronized (this) {
+            image = null;
+            rect = new HScreenRectangle(0.0f, 0.0f, 1.0f, 1.0f);
+            decodedPixels = null;
+            decodedWidth = 0;
+            decodedHeight = 0;
+        }
+    }
+
+    int[] getDecodedPixels() {
+        return decodedPixels;
+    }
+
+    int getDecodedWidth() {
+        return decodedWidth;
+    }
+
+    int getDecodedHeight() {
+        return decodedHeight;
     }
 
