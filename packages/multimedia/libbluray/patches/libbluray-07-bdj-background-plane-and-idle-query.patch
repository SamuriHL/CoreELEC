+
+package org.havi.ui;
+
+import java.awt.Color;
+
+import org.videolan.BDJXletContext;
+import org.videolan.GUIManager;
+import org.videolan.Libbluray;
+import org.videolan.Logger;
+
+/*
+ * The HAVi background plane (behind video), delivered to the player as the
+ * BD_OVERLAY_BG ARGB overlay plane.
+ *
+ * The plane is re-rendered from the current HBackgroundConfiguration whenever
+ * the configuration, its colour, or its still image changes: fill with the
+ * configuration colour, then draw the configuration's still image (if any)
+ * scaled into its HScreenRectangle. A fully transparent colour with no image
+ * closes the plane.
+ *
+ * Callers are xlet lifecycle threads, the event dispatch thread, xlet-owned
+ * threads and image fetcher threads, so all state lives under one lock. The
+ * native push takes the OSD buffer mutex and never calls back into Java, so
+ * holding this lock across it keeps the lock order one-way.
+ */
+final class BackgroundPlane {
+
+    private static final Object lock = new Object();
+    private static final Logger logger = Logger.getLogger(BackgroundPlane.class.getName());
+
+    private static HBackgroundConfiguration current = null;
+    private static BDJXletContext owner = null;
+    private static int[] pixels = null;
+    private static int width = 0;
+    private static int height = 0;
+    private static boolean open = false;
+
+    private BackgroundPlane() {
+    }
+
+    /* HBackgroundDevice.setBackgroundConfiguration() */
+    static void configurationChanged(HBackgroundConfiguration hbc) {
+        synchronized (lock) {
+            current = hbc;
+            touch();
+            render();
+        }
+    }
+
+    /* HBackgroundConfiguration.setColor() / HStillImageBackgroundConfiguration image change */
+    static void contentChanged(HBackgroundConfiguration hbc) {
+        synchronized (lock) {
+            if (hbc != current) {
+                /* nothing tracked yet (startup, or after a reset): the device
+                 * starts on its default configuration, and re-selecting it is a
+                 * no-op there, so adopt it if it is the device's current one */
+                if (current != null || hbc != deviceConfiguration())
+                    return; /* shown when it becomes current */
+                current = hbc;
+            }
+            touch();
+            render();
+        }
+    }
+
+    /* A new title started: drop the background if the xlet that set it is gone. */
+    static void releaseIfOwnerGone() {
+        synchronized (lock) {
+            if (owner != null && owner.isReleased()) {
+                logger.info("background owner released, resetting background plane");
+                resetLocked();
+            }
+        }
+    }
+
+    /* BD-J title unload / disc shutdown: back to the transparent default. */
+    static void reset() {
+        synchronized (lock) {
+            resetLocked();
+        }
+    }
+
+    private static void resetLocked() {
+        HScreen screen = HScreen.getDefaultHScreen();
+        if (screen != null) {
+            HBackgroundDevice device = screen.getDefaultHBackgroundDevice();
+            if (device != null)
+                device.resetBackground();
+        }
+        current = null;
+        owner = null;
+        close();
+    }
+
+    private static HBackgroundConfiguration deviceConfiguration() {
+        HScreen screen = HScreen.getDefaultHScreen();
+        if (screen == null)
+            return null;
+        HBackgroundDevice device = screen.getDefaultHBackgroundDevice();
+        return (device != null) ? device.getCurrentConfiguration() : null;
+    }
+
+    private static void touch() {
+        BDJXletContext ctx = BDJXletContext.getCurrentContext();
+        if (ctx != null)
+            owner = ctx;
+    }
+
+    private static void close() {
+        if (open) {
+            Libbluray.updateBackground(0, 0, null);
+            open = false;
+        }
+        pixels = null;
+    }
+
+    private static void render() {
+        HBackgroundConfiguration hbc = current;
+        if (hbc == null) {
+            close();
+            return;
+        }
+
+        Color color = hbc.getColor();
+        int argb = (color != null) ? color.getRGB() : 0;
+
+        int[] img = null;
+        int imgW = 0, imgH = 0;
+        HScreenRectangle rect = null;
+        if (hbc instanceof HStillImageBackgroundConfiguration) {
+            HStillImageBackgroundConfiguration still = (HStillImageBackgroundConfiguration)hbc;
+            synchronized (still) {
+                img = still.getDecodedPixels();
+                imgW = still.getDecodedWidth();
+                imgH = still.getDecodedHeight();
+                rect = still.getRectangle();
+            }
+        }
+
+        if ((argb >>> 24) == 0 && img == null) {
+            close();
+            return;
+        }
+
+        int w = 0, h = 0;
+        try {
+            GUIManager gui = GUIManager.getInstance();
+            w = gui.getWidth();
+            h = gui.getHeight();
+        } catch (Error e) {
+        }
+        if (w <= 0 || h <= 0) {
+            w = 1920;
+            h = 1080;
+        }
+
+        if (pixels == null || width != w || height != h) {
+            if (open) {
+                Libbluray.updateBackground(0, 0, null);
+                open = false;
+            }
+            pixels = new int[w * h];
+            width = w;
+            height = h;
+        }
+
+        java.util.Arrays.fill(pixels, argb);
+
+        if (img != null && imgW > 0 && imgH > 0 && rect != null)
+            blit(img, imgW, imgH, rect);
+
+        if (!open) {
+            Libbluray.updateBackground(width, height, null);
+            open = true;
+        }
+        Libbluray.updateBackground(width, height, pixels);
+    }
+
+    /* nearest-neighbour scale of the decoded image into the normalized rectangle */
+    private static void blit(int[] img, int imgW, int imgH, HScreenRectangle rect) {
+        int dx0 = Math.round(rect.x * width);
+        int dy0 = Math.round(rect.y * height);
+        int dw  = Math.round(rect.width * width);
+        int dh  = Math.round(rect.height * height);
+        if (dw <= 0 || dh <= 0)
+            return;
+
+        int x0 = Math.max(0, dx0), x1 = Math.min(width,  dx0 + dw);
+        int y0 = Math.max(0, dy0), y1 = Math.min(height, dy0 + dh);
+
+        for (int y = y0; y < y1; y++) {
+            int sy = (int)(((long)(y - dy0) * imgH) / dh);
+            int srow = sy * imgW;
+            int drow = y * width;
+            for (int x = x0; x < x1; x++) {
+                int sx = (int)(((long)(x - dx0) * imgW) / dw);
+                int p = img[srow + sx];
+                int a = p >>> 24;
+                if (a == 0xff) {
+                    pixels[drow + x] = p;
+                } else if (a != 0) {
+                    /* image over the colour fill */
+                    int d = pixels[drow + x];
+                    int ia = 255 - a;
+                    int da = d >>> 24;
+                    int oa = a + (da * ia) / 255;
+                    int r = (((p >> 16) & 0xff) * a + ((d >> 16) & 0xff) * ia) / 255;
+                    int g = (((p >>  8) & 0xff) * a + ((d >>  8) & 0xff) * ia) / 255;
+                    int b = (( p        & 0xff) * a + ( d        & 0xff) * ia) / 255;
+                    pixels[drow + x] = (oa << 24) | (r << 16) | (g << 8) | b;
+                }
+            }
+        }
+    }
+}
