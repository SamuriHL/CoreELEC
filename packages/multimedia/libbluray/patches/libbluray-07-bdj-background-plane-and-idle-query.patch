+int bd_bdj_waiting_for_playback(BLURAY *bd)
+{
+    int waiting;
+
+    if (!bd) {
+        return 0;
+    }
+
+    bd_mutex_lock(&bd->mutex);
+    /* a BD-J title with no playlist open (1), or one it has prefetched but
+     * not started (2; playback begins in bdpriv_select_rate()): bd_read() has
+     * nothing to deliver until the Xlet acts */
+    if (bd->title_type != title_bdj) {
+        waiting = 0;
+    } else if (!bd->title) {
+        waiting = 1;
+    } else {
+        waiting = bd->bdj_wait_start ? 2 : 0;
+    }
+    bd_mutex_unlock(&bd->mutex);
+
+    return waiting;
+}
