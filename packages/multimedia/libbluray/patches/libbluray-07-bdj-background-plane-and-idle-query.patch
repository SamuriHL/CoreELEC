+/* HAVi background plane (org.havi.ui.BackgroundPlane). Whole-plane updates
+ * only; the pixels always come from the Java array, never an
+ * application-allocated BD_ARGB_BUFFER. rgbArray == NULL with a size opens
+ * the plane, with no size closes it. */
+JNIEXPORT void JNICALL Java_org_videolan_Libbluray_updateBackgroundN(JNIEnv * env,
+        jclass cls, jlong np, jint width, jint height, jintArray rgbArray) {
+
+    BLURAY* bd = (BLURAY*)(intptr_t)np;
+
+    BD_DEBUG(DBG_JNI, "updateBackgroundN(%ldx%ld, %s)\n", (long)width, (long)height,
+             rgbArray ? "draw" : "init/close");
+
+    if (!bd) {
+        return;
+    }
+
+    /* same lock as updateGraphicN: the overlay proc is replaced under it */
+    bdpriv_lock_osd_buffer(bd);
+
+    if (!rgbArray) {
+        bdpriv_bdj_bg_cb(bd, NULL, (int)width, (int)height, 0, 0, 0, 0);
+    } else if (width > 0 && height > 0 &&
+               (*env)->GetArrayLength(env, rgbArray) >= (jsize)(width * height)) {
+        jint *image = (jint *)(*env)->GetPrimitiveArrayCritical(env, rgbArray, NULL);
+        if (image) {
+            bdpriv_bdj_bg_cb(bd, (const unsigned *)image, (int)width, (int)height,
+                             0, 0, (int)width - 1, (int)height - 1);
+            (*env)->ReleasePrimitiveArrayCritical(env, rgbArray, image, JNI_ABORT);
+        } else {
+            BD_DEBUG(DBG_BDJ | DBG_CRIT, "updateBackgroundN: GetPrimitiveArrayCritical() failed\n");
+        }
+    } else {
+        BD_DEBUG(DBG_BDJ | DBG_CRIT, "updateBackgroundN: array smaller than %ldx%ld\n",
+                 (long)width, (long)height);
+    }
+
+    bdpriv_unlock_osd_buffer(bd);
+}
