+++ b/src/libbluray/bdj/java/org/videolan/Libbluray.java
@@ -780,6 +780,7 @@
         case BDJ_EVENT_UO_MASKED:
         case BDJ_EVENT_SEEK:
         case BDJ_EVENT_RATE:
+        case BDJ_EVENT_CLOCK_SHIFT:
             result = PlayerManager.getInstance().onEvent(event, param);
             break;
 
@@ -884,6 +885,8 @@
     public  static final int BDJ_EVENT_UO_MASKED                = 17;
     private static final int BDJ_EVENT_MOUSE                    = 18;
 
+    public  static final int BDJ_EVENT_CLOCK_SHIFT              = 19;
+
     public static final int AACS_DISC_ID           = 1;
     public static final int AACS_MEDIA_VID         = 2;
     public static final int AACS_MEDIA_PMSN        = 3;
--- a/src/libbluray/bdj/java/org/videolan/media/content/BDHandler.java
+++ b/src/libbluray/bdj/java/org/videolan/media/content/BDHandler.java
@@ -377,6 +377,18 @@
         }
     }
 
+    /* The player held its clock for ticks (90 kHz) after this player started
+     * (a display mode change before the first picture): the media time must
+     * not have run on during it. Not an application-visible event. */
+    protected void doClockShift(long ticks) {
+        synchronized (this) {
+            if (state == Started && rate != 0.0f) {
+                baseTime += ticks * 100000L / 9L; /* 90 kHz -> ns */
+                Logger.getLogger("BDHandler").info("media clock shifted by " + (ticks / 90) + " ms");
+            }
+        }
+    }
+
     protected void doSeekNotify(long tick) {
         updateTime(new Time(tick * TO_SECONDS));
     }
@@ -676,6 +688,9 @@
                 case Libbluray.BDJ_EVENT_SEEK:
                     player.doSeekNotify(param2 * 2 /* 45kHz -> 90kHz */);
                     break;
+                case Libbluray.BDJ_EVENT_CLOCK_SHIFT:
+                    player.doClockShift(param2 & 0xffffffffL);
+                    break;
                 case Libbluray.BDJ_EVENT_RATE:
                     float rate = (float)param2 / 90000.0f;
                     if (rate < 0.0f) rate = -rate;
