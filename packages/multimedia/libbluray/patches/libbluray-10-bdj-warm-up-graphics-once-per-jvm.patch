+package java.awt;
+
+import org.videolan.Logger;
+
+/*
+ * Warm up the software graphics pipeline once per JVM.
+ *
+ * Discs time the player's graphics speed when their menu starts and pick a
+ * simpler menu below a threshold (e.g. Superman UHD: 100 offscreen fills +
+ * blits, full menu at >= 85 per second). On the first disc after the JVM
+ * started, the span/blend loops still run interpreted and score ~40% below
+ * the same box a minute later, so the disc gets its reduced menu. A standalone
+ * player's graphics are never cold.
+ *
+ * Run the same kind of work on private offscreen images in a low-priority
+ * daemon thread so the JIT compiles those loops before the disc's menu starts.
+ * Nothing is drawn to the screen and no disc state is touched.
+ */
+public final class BDGraphicsWarmup {
+
+    private static final Logger logger = Logger.getLogger(BDGraphicsWarmup.class.getName());
+
+    private static final int  MAX_ROUNDS = 300;
+    private static final long MAX_MS     = 1500;
+
+    private static boolean started = false;
+
+    private BDGraphicsWarmup() {
+    }
+
+    public static synchronized void start() {
+        if (started)
+            return;
+        started = true;
+
+        Thread t = new Thread("BD-J graphics warm-up") {
+            public void run() {
+                try {
+                    warmUp();
+                } catch (Throwable e) {
+                    logger.error("graphics warm-up failed: " + e);
+                }
+            }
+        };
+        t.setDaemon(true);
+        t.setPriority(Thread.MIN_PRIORITY);
+        t.start();
+    }
+
+    private static void warmUp() {
+        /* a parent with a font keeps BDGraphics from asking GUIManager,
+         * which does not exist before the first title loads */
+        Component owner = new Component() {};
+        owner.setFont(new Font("Dialog", Font.PLAIN, 12));
+
+        BDImage src = new BDImage(owner, 720, 480, null);
+        BDImage dst = new BDImage(owner, 1920, 1080, null);
+        Color clear = new Color(0, 0, 0, 0);
+        Color translucent = new Color(40, 80, 120, 128);
+        Color opaque = new Color(200, 160, 120);
+
+        long begin = System.currentTimeMillis();
+        long first = -1, lastTen = 0;
+        int rounds = 0;
+        while (rounds < MAX_ROUNDS && System.currentTimeMillis() - begin < MAX_MS) {
+            long t0 = System.currentTimeMillis();
+
+            Graphics2D g = (Graphics2D)src.getGraphics();
+            g.setComposite(AlphaComposite.SrcOver);
+            g.setColor((rounds % 3) == 0 ? clear : ((rounds % 3) == 1 ? translucent : opaque));
+            g.fillRect(0, 0, 720, 480);
+            g.dispose();
+
+            Graphics2D d = (Graphics2D)dst.getGraphics();
+            d.setComposite(AlphaComposite.SrcOver);
+            d.drawImage(src, 600, 300, null);
+            if ((rounds % 10) == 9) {
+                d.setComposite(AlphaComposite.Clear);
+                d.fillRect(0, 0, 1920, 1080);
+            }
+            d.dispose();
+
+            long dt = System.currentTimeMillis() - t0;
+            if (first < 0)
+                first = dt;
+            if (rounds >= MAX_ROUNDS - 10)
+                lastTen += dt;
+            rounds++;
+        }
+
+        logger.info("graphics warm-up: " + rounds + " rounds in " + (System.currentTimeMillis() - begin)
+                    + "ms (first " + first + "ms"
+                    + (rounds == MAX_ROUNDS ? ", last 10 avg " + (lastTen / 10) + "ms" : ", stopped at time limit")
+                    + ")");
+    }
+}
diff --git a/src/libbluray/bdj/java/org/videolan/Libbluray.java b/src/libbluray/bdj/java/org/videolan/Libbluray.java
index e29e483..8185620 100644
--- a/src/libbluray/bdj/java/org/videolan/Libbluray.java
+++ b/src/libbluray/bdj/java/org/videolan/Libbluray.java
@@ -406,6 +406,13 @@ public class Libbluray {
         }
 
         booted = true;
+
+        /* once per JVM: compile the graphics loops before a disc times them */
+        try {
+            java.awt.BDGraphicsWarmup.start();
+        } catch (Throwable t) {
+            System.err.println("graphics warm-up not started: " + t);
+        }
     }
 
     /* called only from native code */
