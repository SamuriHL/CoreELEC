+
+int bd_bdj_start_pending(BLURAY *bd, uint32_t *start_seq)
+{
+    int pending;
+    bd_mutex_lock(&bd->mutex);
+    pending = bd->bdj_start_unresolved && bd->bdj_pt_count > 0 && bd->title_type == title_bdj;
+    if (pending && start_seq) {
+        *start_seq = bd->bdj_start_seq;
+    }
+    bd_mutex_unlock(&bd->mutex);
+    return pending;
+}
