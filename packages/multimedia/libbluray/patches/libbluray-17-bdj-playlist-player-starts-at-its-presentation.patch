+    /*
+     * Start at presentation (libbluray presentation timing with deferred start).
+     *
+     * The playlist player starts reading at once, but the player shows its
+     * first picture later: it reads ahead, and may change the display mode
+     * first. A StartEvent is "the media is playing"; applications time their
+     * own UI from it. So the StartEvent, MediaPresentedEvent and the media
+     * clock wait for the player's release of the start's marker (the first
+     * picture), with the reader's statuses for the start buffered behind them.
+     */
+
+    private void beginPendingStart(Time at) {
+        startPending = true;
+        pendingGen = deferredStartGen;
+        pendingAt = at;
+        pendingSince = System.currentTimeMillis();
+        heldStatus.clear();
+        if (pendingTask != null)
+            pendingTask.cancel();
+        pendingTask = new TimerTask() {
+            public void run() {
+                if (isClosed) {
+                    cancel();
+                    return;
+                }
+                commandQueue.put(new PlayerAction(BDHandler.this, PlayerAction.ACTION_STATUS,
+                                                  Integer.valueOf(PRESENTATION_POLL), 0));
+            }
+        };
+        pendingTimer().schedule(pendingTask, 100, 100);
+        logger.info("start " + pendingGen + " waits for its first picture");
+    }
+
+    private void resolvePendingStart(String how, boolean presented) {
+        long waited;
+        synchronized (this) {
+            if (!startPending)
+                return;
+            long startNs = 0;
+            if (presented && Libbluray.presentationInfo(2) == pendingGen)
+                startNs = Libbluray.presentationInfo(3);
+            baseTime = getTimeBase().getNanoseconds();
+            if (startNs != 0)
+                baseTime -= System.nanoTime() - startNs;
+            startPending = false;
+            waited = System.currentTimeMillis() - pendingSince;
+        }
+        if (pendingTask != null) {
+            pendingTask.cancel();
+            pendingTask = null;
+        }
+        logger.info("start " + pendingGen + " " + how + " after " + waited + " ms" +
+                    " (media clock starts " + ((baseTime - getTimeBase().getNanoseconds()) / 1000000L) + " ms from now)");
+        notifyListeners(new StartEvent(this, Prefetched, Started, Started, pendingAt, getMediaTime()));
+        // Send MediaPresentedEvent after StartEvent - some discs rely on this to show menus
+        notifyListeners(new MediaPresentedEvent(this));
+        while (!heldStatus.isEmpty()) {
+            int[] status = (int[])heldStatus.removeFirst();
+            handleStatus(status[0], status[1]);
+        }
+    }
+
+    /* an application action on a player whose start waits: the start is the
+     * application's past, so it happens first */
+    protected void endPendingStart(String action) {
+        if (startPending)
+            resolvePendingStart("ended by " + action, false);
+    }
+
+    private void onStatus(int event, int param) {
+        if (event == Libbluray.BDJ_EVENT_PRESENTATION_START) {
+            if (startPending && (param & 0xffffffffL) == pendingGen)
+                resolvePendingStart("presented", true);
+            return;
+        }
+        if (event == PRESENTATION_POLL) {
+            if (!startPending)
+                return;
+            if (Libbluray.presentationInfo(2) == pendingGen) {
+                resolvePendingStart("presented (poll)", true);
+            } else if (System.currentTimeMillis() - pendingSince > PENDING_START_LIMIT_MS) {
+                logger.error("start " + pendingGen + ": no first picture reported in " + PENDING_START_LIMIT_MS + " ms, starting anyway");
+                resolvePendingStart("fallback", false);
+            }
+            return;
+        }
+        if (startPending) {
+            switch (event) {
+            case Libbluray.BDJ_EVENT_SEEK:
+            case Libbluray.BDJ_EVENT_PLAYLIST:
+                /* the reader's own start position: the start already holds it */
+            case Libbluray.BDJ_EVENT_PTS:
+                return;
+            default:
+                heldStatus.addLast(new int[] { event, param });
+                return;
+            }
+        }
+        handleStatus(event, param);
+    }
+
+    private static synchronized Timer pendingTimer() {
+        if (pendingStartTimer == null)
+            pendingStartTimer = new Timer(true);
+        return pendingStartTimer;
+    }
